# Copy to .env and fill in. Never commit .env.
# Host port on 127.0.0.1. 3004 is a guess: check it is free with
#   sudo ss -lntp "sport = :3004"
APP_PORT=3004

DB_NAME=gymtracker
DB_USERNAME=gymtracker
DB_PASSWORD=change-me

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Keep true when the app is served over HTTPS (Tailscale Serve) or opened on localhost (SSH tunnel).
# Set false only for plain HTTP on another hostname, for example http://home.pi.home.arpa.
# With false, anyone who can watch your network traffic can copy a session cookie.
SESSION_COOKIE_SECURE=true
